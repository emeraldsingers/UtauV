<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenUtau.App.Views.LayoutRepairDialog"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource layoutrepair.title}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Width="560" Height="340">
  <Grid Margin="{Binding $parent.WindowDecorationMargin}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
      <Grid ColumnDefinitions="Auto,14,*">
        <Image Width="44" Height="44" Source="/Assets/open-utau.ico" Stretch="Uniform"/>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                   TextWrapping="Wrap" Text="{DynamicResource layoutrepair.heading}"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="10">
        <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Opacity="0.9"
                   Text="{DynamicResource layoutrepair.message}"/>
        <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" FontWeight="SemiBold"
                   Text="{DynamicResource layoutrepair.steps}"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button MinWidth="110" Content="{DynamicResource layoutrepair.later}" Click="Later"/>
        <Button MinWidth="110" Classes="accent" Content="{DynamicResource layoutrepair.fix}" Click="Fix"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
