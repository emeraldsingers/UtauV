<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600" Width="400"
             x:Class="OpenUtau.App.Controls.NotePropertiesControl"
             KeyDown="OnKeyDown" Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button,CheckBox">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Label,TextBox,Slider,ComboBox,CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.fader">
      <Setter Property="Focusable" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <TextBlock Text="{Binding Title}" Height="24" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <ScrollViewer Margin="0,48,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
      <StackPanel Margin="0">
        <Expander Header="{DynamicResource noteproperty.basic}" HorizontalAlignment="Stretch" Margin="0,0,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource notedefaults.lyric}" Grid.Column="0"/>
              <TextBox Text="{Binding Lyric, Mode=OneWay}" Grid.Column="1" Tag="Lyric"/>
            </Grid>

            <!-- to be updated later to use the same categ phonemizer -->
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.phonemizer}" Grid.Column="0"/>
              <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2"
                      Content="{Binding PhonemizerOverrideText}"
                      Click="OnPhonemizerButtonClicked">
                <Button.ContextMenu>
                  <ContextMenu Name="PhonemizerMenu" ItemsSource="{Binding PhonemizerMenuItems}" Placement="Left">
                    <ContextMenu.Styles>
                      <Style Selector="MenuItem">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command, FallbackValue={x:Null}}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="ItemsSource" Value="{Binding Items}"/>
                      </Style>
                    </ContextMenu.Styles>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.tone}" Grid.Column="0"/>
              <TextBox Text="{Binding Tone, Mode=OneWay}" Grid.Column="1" Tag="Tone" Margin="0"/>
            </Grid>
            <c:NumberSlider Tag="Tuning" Label="{DynamicResource noteproperty.tuning}" Margin="0,2,0,0"
                            LabelFontWeight="{Binding TuningFontWeight}"
                            Value="{Binding Tuning}" Minimum="-100" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True" Format="{}{0:#0}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource notedefaults.portamento}" HorizontalAlignment="Stretch" Margin="0,2,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource notedefaults.preset}"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding PortamentoPresets}" Margin="0"
                SelectedItem="{Binding ApplyPortamentoPreset}" HorizontalAlignment="Stretch"/>
            </Grid>
            <Grid ColumnDefinitions="123,20,*,20,*">
              <Button Grid.Column="2" Content="{DynamicResource button.save}"
                      HorizontalAlignment="Stretch" Click="OnSavePortamentoPreset"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.save.tooltip}"/>
              <Button Grid.Column="4" Content="{DynamicResource button.remove}"
                      HorizontalAlignment="Stretch" Command="{Binding RemoveAppliedPortamentoPreset}"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.remove.tooltip}"/>
            </Grid>
            <c:NumberSlider Tag="PortamentoLength" Label="{DynamicResource notedefaults.portamento.length}" Margin="0,2,0,0"
                            Value="{Binding PortamentoLength}" Minimum="2" Maximum="320"
                            TickFrequency="1" IsSnapToTickEnabled="True" Format="{}{0:#0}"/>
            <c:NumberSlider Tag="PortamentoStart" Label="{DynamicResource notedefaults.portamento.start}" Margin="0,2,0,0"
                            Value="{Binding PortamentoStart}" Minimum="-200" Maximum="200"
                            TickFrequency="1" IsSnapToTickEnabled="True" Format="{}{0:#0}"/>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource context.pitch.shape}"/>
              <ComboBox Grid.Column="2" Margin="0" SelectedIndex="{Binding PitchCurveShape}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{DynamicResource context.pitch.easeinout}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.linear}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.easein}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.easeout}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.smooth}"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource notedefaults.vibrato}" HorizontalAlignment="Stretch" Margin="0,2,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <ToggleSwitch IsChecked="{Binding VibratoEnable, Mode=OneWay}" OnContent="{DynamicResource button.on}" OffContent="{DynamicResource button.off}"
                          Click="VibratoEnableClicked"/>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource notedefaults.preset}"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding VibratoPresets}" Margin="0"
                SelectedItem="{Binding ApplyVibratoPreset}" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid ColumnDefinitions="123,20,*,20,*">
              <Button Grid.Column="2" Content="{DynamicResource button.save}"
                      HorizontalAlignment="Stretch" Click="OnSaveVibratoPreset"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.save.tooltip}"/>
              <Button Grid.Column="4" Content="{DynamicResource button.remove}"
                HorizontalAlignment="Stretch" Command="{Binding RemoveAppliedVibratoPreset}"
                ToolTip.Tip="{DynamicResource notedefaults.preset.remove.tooltip}"/>
            </Grid>
            <c:NumberSlider Tag="VibratoLength" Label="{DynamicResource notedefaults.vibrato.length}" Margin="0,2,0,0"
                            Value="{Binding VibratoLength}" Minimum="0" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" IsDirectionReversed="True"/>
            <c:NumberSlider Tag="VibratoPeriod" Label="{DynamicResource notedefaults.vibrato.period}" Margin="0,2,0,0"
                            Value="{Binding VibratoPeriod}" Minimum="5" Maximum="500"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoDepth" Label="{DynamicResource notedefaults.vibrato.depth}" Margin="0,2,0,0"
                            Value="{Binding VibratoDepth}" Minimum="5" Maximum="200"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoIn" Label="{DynamicResource notedefaults.vibrato.in}" Margin="0,2,0,0"
                            Value="{Binding VibratoIn}" Minimum="0" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoOut" Label="{DynamicResource notedefaults.vibrato.out}" Margin="0,2,0,0"
                            Value="{Binding VibratoOut}" Minimum="0" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoShift" Label="{DynamicResource notedefaults.vibrato.shift}" Margin="0,2,0,0"
                            Value="{Binding VibratoShift}" Minimum="0" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoDrift" Label="{DynamicResource notedefaults.vibrato.drift}" Margin="0,2,0,0"
                            Value="{Binding VibratoDrift}" Minimum="-100" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VibratoVolLink" Label="{DynamicResource notedefaults.vibrato.vollink}" Margin="0,2,0,0"
                            Value="{Binding VibratoVolLink}" Minimum="-100" Maximum="100"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <c:NumberSlider Tag="VariationDepth" Label="{DynamicResource notedefaults.vibrato.variationdepth}" Margin="0,2,0,0"
                            Value="{Binding VariationDepth}" Minimum="0" Maximum="2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{DynamicResource notedefaults.vibrato.variationdepth.tooltip}"/>
            <c:NumberSlider Tag="PitchVariationDepth" Label="{DynamicResource notedefaults.vibrato.pitchvariationdepth}" Margin="0,2,0,0"
                            Value="{Binding PitchVariationDepth}" Minimum="0" Maximum="2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{DynamicResource notedefaults.vibrato.pitchvariationdepth.tooltip}"/>
            <c:NumberSlider Tag="VariationFrequency" Label="{DynamicResource notedefaults.vibrato.variationfreq}" Margin="0,2,0,0"
                            Value="{Binding VariationFrequency}" Minimum="0.1" Maximum="8"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <Grid ColumnDefinitions="130,20,50,20,*">
              <Label Content="{DynamicResource notedefaults.vibrato.variationseed}"/>
              <TextBox Grid.Column="2" Text="{Binding VariationSeed, Mode=OneWay}" Tag="VariationSeed"/>
              <Button Grid.Column="4" Content="{DynamicResource notedefaults.vibrato.newvariationseed}"
                      HorizontalAlignment="Stretch" Click="OnNewVariationSeed"/>
            </Grid>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource noteproperty.setlongnote}"/>
              <CheckBox Grid.Column="2" IsChecked="{Binding AutoVibratoToggle}"/>
            </Grid>
            <c:NumberSlider Tag="AutoVibratoNoteLength" Label="{DynamicResource notedefaults.vibrato.autominlength}" Margin="0,2,0,0"
                            IsEnabled="{Binding AutoVibratoToggle}"
                            Value="{Binding AutoVibratoNoteLength}" Minimum="10" Maximum="1920"
                            TickFrequency="1" IsSnapToTickEnabled="True" Format="{}{0:#0}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource exps.caption}" HorizontalAlignment="Stretch" Margin="0,2,4,0">
          <StackPanel Name="ExpressionsPanel" />
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
