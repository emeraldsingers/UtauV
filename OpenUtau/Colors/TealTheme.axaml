<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <Color x:Key="BackgroundColor">#1E2326</Color>
  <Color x:Key="BackgroundColorPointerOver">#242B2F</Color>
  <Color x:Key="BackgroundColorPressed">#303A40</Color>
  <Color x:Key="BackgroundColorDisabled">#262E33</Color>
  <Color x:Key="ForegroundColor">#C1CAD0</Color>
  <Color x:Key="ForegroundColorPointerOver">#DEE6EB</Color>
  <Color x:Key="ForegroundColorPressed">#9EA9B1</Color>
  <Color x:Key="ForegroundColorDisabled">#7A848C</Color>
  <Color x:Key="BorderColor">#3A454D</Color>
  <Color x:Key="BorderColorPointerOver">#52606A</Color>
  <Color x:Key="SystemAccentColor">#5FAE8B</Color>
  <Color x:Key="SystemAccentColorLight1">#88CCAE</Color>
  <Color x:Key="SystemAccentColorDark1">#478167</Color>
  <Color x:Key="NeutralAccentColor">#8C989F</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#A4B0B8</Color>
  <Color x:Key="AccentColor1">#5FAE8B</Color>
  <Color x:Key="AccentColor2">#88CCAE</Color>
  <Color x:Key="AccentColor3">#C5D2DA</Color>
  <Color x:Key="TickLineColor">#171D21</Color>
  <Color x:Key="BarNumberColor">#B2BEC6</Color>
  <Color x:Key="FinalPitchColor">#68737B</Color>
  <Color x:Key="TrackBackgroundAltColor">#2A3339</Color>
  <Color x:Key="WarningColor">#433519</Color>
  <Color x:Key="WhiteKeyColorLeft">#4E5961</Color>
  <Color x:Key="WhiteKeyColorRight">#4E5961</Color>
  <Color x:Key="WhiteKeyNameColor">#F3F6F8</Color>
  <Color x:Key="CenterKeyColorLeft">#90A4AF</Color>
  <Color x:Key="CenterKeyColorRight">#90A4AF</Color>
  <Color x:Key="CenterKeyNameColor">#FFFFFF</Color>
  <Color x:Key="BlackKeyColorLeft">#1A1F22</Color>
  <Color x:Key="BlackKeyColorRight">#1A1F22</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
