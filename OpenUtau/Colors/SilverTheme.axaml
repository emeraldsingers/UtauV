<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>
  <Color x:Key="BackgroundColor">#EEF0F2</Color><Color x:Key="BackgroundColorPointerOver">#E1E5E8</Color><Color x:Key="BackgroundColorPressed">#D3D9DE</Color><Color x:Key="BackgroundColorDisabled">#E6E8EA</Color>
  <Color x:Key="ForegroundColor">#1D2227</Color><Color x:Key="ForegroundColorPointerOver">#0C1115</Color><Color x:Key="ForegroundColorPressed">#303840</Color><Color x:Key="ForegroundColorDisabled">#7B858D</Color><Color x:Key="BorderColor">#AEB7BF</Color><Color x:Key="BorderColorPointerOver">#66727C</Color>
  <Color x:Key="SystemAccentColor">#596873</Color><Color x:Key="SystemAccentColorLight1">#8796A2</Color><Color x:Key="SystemAccentColorDark1">#35424C</Color><Color x:Key="NeutralAccentColor">#98A2AA</Color><Color x:Key="NeutralAccentColorPointerOver">#68747D</Color><Color x:Key="AccentColor1">#74828C</Color><Color x:Key="AccentColor2">#26323B</Color><Color x:Key="AccentColor3">#A9B8C1</Color>
  <Color x:Key="TickLineColor">#CBD1D5</Color><Color x:Key="BarNumberColor">#20272D</Color><Color x:Key="FinalPitchColor">#4D7890</Color><Color x:Key="TrackBackgroundAltColor">#E3E7EA</Color>
  <Color x:Key="WhiteKeyColorLeft">#FFFFFF</Color><Color x:Key="WhiteKeyColorRight">#E4E8EB</Color><Color x:Key="WhiteKeyNameColor">#1B2228</Color><Color x:Key="CenterKeyColorLeft">#C7CED3</Color><Color x:Key="CenterKeyColorRight">#A8B2B9</Color><Color x:Key="CenterKeyNameColor">#1B2228</Color><Color x:Key="BlackKeyColorLeft">#4C5861</Color><Color x:Key="BlackKeyColorRight">#273139</Color><Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
