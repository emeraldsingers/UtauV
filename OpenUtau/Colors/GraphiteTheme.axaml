<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>
  <Color x:Key="BackgroundColor">#17191C</Color><Color x:Key="BackgroundColorPointerOver">#25282D</Color><Color x:Key="BackgroundColorPressed">#30343A</Color><Color x:Key="BackgroundColorDisabled">#202226</Color>
  <Color x:Key="ForegroundColor">#F5F7FA</Color><Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color><Color x:Key="ForegroundColorPressed">#D9DEE5</Color><Color x:Key="ForegroundColorDisabled">#858C96</Color>
  <Color x:Key="BorderColor">#464C54</Color><Color x:Key="BorderColorPointerOver">#AAB2BC</Color>
  <Color x:Key="SystemAccentColor">#D9DEE5</Color><Color x:Key="SystemAccentColorLight1">#FFFFFF</Color><Color x:Key="SystemAccentColorDark1">#8D96A1</Color>
  <Color x:Key="NeutralAccentColor">#858C96</Color><Color x:Key="NeutralAccentColorPointerOver">#C5CBD3</Color><Color x:Key="AccentColor1">#4A535E</Color><Color x:Key="AccentColor2">#71818D</Color><Color x:Key="AccentColor3">#8FA8BC</Color>
  <Color x:Key="TickLineColor">#30353B</Color><Color x:Key="BarNumberColor">#F5F7FA</Color><Color x:Key="FinalPitchColor">#B7D0DF</Color><Color x:Key="TrackBackgroundAltColor">#202328</Color>
  <Color x:Key="WhiteKeyColorLeft">#F8FAFC</Color><Color x:Key="WhiteKeyColorRight">#DDE2E8</Color><Color x:Key="WhiteKeyNameColor">#15171A</Color><Color x:Key="CenterKeyColorLeft">#B9C1CB</Color><Color x:Key="CenterKeyColorRight">#8C96A2</Color><Color x:Key="CenterKeyNameColor">#15171A</Color><Color x:Key="BlackKeyColorLeft">#30353B</Color><Color x:Key="BlackKeyColorRight">#17191C</Color><Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
